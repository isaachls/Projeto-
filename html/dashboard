    </header>

    <main class="conteudo-carrinho">
    
        <section class="carrinho">
            <h1> Meu <strong>carrinho</strong></h1>
            
            <div class="traco"></div>

            <div class="pedido">
                
                <div class="camisa-1">
                    <input type="checkbox" class="selecionar">
                    <div class="balao-roupa-carrinho">
                        <img  src="img/blusa-marrom.png">
                    </div>
                    
                    <div class="infos-pedido">
                     <h2>Camisa Oversized</h2>
                     <p>R$80,50</p>
                     <p>TAM: P</p>
                     <p>COR: Marrom</p>
                    </div>
                      <div class="preco">
                       <h2>R$80,50</h2>
                      </div>
                </div>

                 <div class="traco"></div>

                <div class="camisa-2">
                    <input type="checkbox" class="selecionar">
                    <div class="balao-roupa-carrinho">
                    <img  src="img/vermelha.png">
                    </div>
                    <div class="infos-pedido">
                      <h2>Camisa Social Wear It</h2>
                      <p>R$119,90</p>
                      <p>TAM: P</p>
                      <p>COR: Vermelho</p>
                    </div>
                    <div class="preco">
                      <h2>R$119,90</h2>
                    </div>
                </div>

            <div class="traco"></div>

        </section>
            
        <section class="resumo">
            <h1> Resumo do <strong>pedido</strong></h1>

            <div class="traco"></div>

            <div class="pedido-valor">
                <div class="subtotal">
                    <h3>Subtotal</h3>
                    <h3>Taxa de entrega</h3>
                </div>
                <div class="valor">
                    <h3>R$90,50</h3>
                </div>
            </div>
            
            <div class="traco"></div>

            <div class="total-valor">
                <div class="total">
                    <h3>Total</h3>
                </div>
                <div class="valor-total">
                    <h3>R$90,50</h3>
                </div>
            </div>


            <div class="traco"></div>

            <div class="cupom">
            
                <label>Cupom</label>
                <input type="text" placeholder="Insira o código de cupom">

                <button>Prosseguir</button>
            
            </div>

        </section>


    </main>

    <footer class="rodape">
            <div class="conteudo">
                <div class="coluna-1">
                    <div class="logo-rodape">
